#!/usr/bin/env bash
# Dev helpers.
#   scripts/dev app       build the UI if needed, start the engine, open the app in the browser
#   scripts/dev ui        UI dev server with hot reload on :5173 (needs the engine running)
#   scripts/dev engine    run the FastAPI engine on :8765 (reload)
#   scripts/dev comfyui   run ComfyUI on :8188
#   scripts/dev ollama    start the Ollama service (brew services)
#   scripts/dev hello     submit a 'hello' job to a running engine and stream progress
#   scripts/dev script "<idea>" [--seconds 60 --style 3d-cartoon]   write a script, print JSON
#   scripts/dev images <project-id> [shot ids…] [--force]   generate shot images (needs ComfyUI)
#   scripts/dev memory    ComfyUI memory and swap per job (data/memory.jsonl)
#   scripts/dev test      run engine tests
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
ENGINE_PORT="${ENGINE_PORT:-8765}"
case "${1:-}" in
  app)
    if [[ ! -f "$ROOT/ui/dist/index.html" || -n "$(find "$ROOT/ui/src" -newer "$ROOT/ui/dist/index.html" -print -quit)" ]]; then
      (cd "$ROOT/ui" && { [[ -d node_modules ]] || npm install --no-audit --no-fund; } && npm run build)
    fi
    (sleep 2; open "http://127.0.0.1:$ENGINE_PORT") &
    cd "$ROOT/engine" && exec .venv/bin/uvicorn app.main:app --host 127.0.0.1 --port "$ENGINE_PORT" --timeout-graceful-shutdown 5 ;;
  ui)
    cd "$ROOT/ui" && { [[ -d node_modules ]] || npm install --no-audit --no-fund; } && exec npm run dev ;;
  engine)
    cd "$ROOT/engine" && exec .venv/bin/uvicorn app.main:app --host 127.0.0.1 --port "$ENGINE_PORT" --reload --timeout-graceful-shutdown 5 ;;
  comfyui)
    DIR="${VIDEO_APP_COMFYUI:-$ROOT/vendor/ComfyUI}"
    # --disable-smart-memory: free models after each run (16 GB shared memory). --fp32-vae: audio VAE needs it on MPS.
    cd "$DIR" && exec .venv/bin/python main.py --listen 127.0.0.1 --port 8188 --disable-smart-memory --fp32-vae --use-pytorch-cross-attention --cache-none ;;
  ollama)
    exec brew services start ollama ;;
  hello)
    cd "$ROOT/engine" && exec .venv/bin/python -m app.cli --url "http://127.0.0.1:$ENGINE_PORT" hello ;;
  script)
    shift; cd "$ROOT/engine" && exec .venv/bin/python -m app.cli --url "http://127.0.0.1:$ENGINE_PORT" script "$@" ;;
  images)
    shift; cd "$ROOT/engine" && exec .venv/bin/python -m app.cli --url "http://127.0.0.1:$ENGINE_PORT" images "$@" ;;
  memory)
    cd "$ROOT/engine" && exec .venv/bin/python -m app.services.memory ;;
  test)
    cd "$ROOT/engine" && exec .venv/bin/python -m pytest -q ;;
  *)
    sed -n '2,13p' "$0"; exit 1 ;;
esac
