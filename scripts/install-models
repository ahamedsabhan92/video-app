#!/usr/bin/env bash
# Download model files into models/ (shared with ComfyUI). Resumable: re-run to continue.
#   scripts/install-models images     FLUX.2 [klein] 4B distilled (fp8) + Qwen3-4B text encoder (fp8) + VAE  (~10 GB)
#   scripts/install-models script     qwen3:8b via Ollama (~5.2 GB)
#   scripts/install-models voice      Kokoro-82M ONNX + voices (~340 MB, Apache-2.0)
#   scripts/install-models music      Stable Audio 3 Small (music) + T5Gemma encoder (~3.5 GB, Stability Community License)
#   scripts/install-models video      Wan 2.2 TI2V-5B (GGUF Q8) + UMT5 encoder + VAE + ComfyUI-GGUF node (~11 GB, Apache-2.0)
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
M="${VIDEO_APP_MODELS:-$ROOT/models}"

fetch() {  # fetch <url> <dest> — resumable, skips finished files
  local url="$1" dest="$2"
  mkdir -p "$(dirname "$dest")"
  if [[ -f "$dest" ]]; then echo "✓ $(basename "$dest") already present"; return; fi
  echo "↓ $(basename "$dest")"
  curl -fL --retry 5 --retry-delay 5 -C - -o "$dest.part" "$url"
  mv "$dest.part" "$dest"
}

case "${1:-}" in
  images)
    # All Apache-2.0: FLUX.2 [klein] 4B (distilled) and Qwen3-4B. (The klein 9B is non-commercial — don't use.)
    fetch https://huggingface.co/black-forest-labs/FLUX.2-klein-4b-fp8/resolve/main/flux-2-klein-4b-fp8.safetensors \
          "$M/diffusion_models/flux-2-klein-4b-fp8.safetensors"
    # Qwen3-4B text encoder, fp8 (5.6 GB). Measured vs bf16 (8 GB): ~30% faster per image, peak memory
    # 9.9 vs 17 GB, near-identical images.
    fetch https://huggingface.co/Comfy-Org/z_image_turbo/resolve/main/split_files/text_encoders/qwen_3_4b_fp8_mixed.safetensors \
          "$M/text_encoders/qwen_3_4b_fp8_mixed.safetensors"
    fetch https://huggingface.co/Comfy-Org/flux2-dev/resolve/main/split_files/vae/flux2-vae.safetensors \
          "$M/vae/flux2-vae.safetensors"
    ;;
  script)
    ollama pull qwen3:8b ;;
  music)
    # Stability AI Community License: commercial use OK under $1M/yr revenue. (MusicGen weights are CC-BY-NC.)
    SA=https://huggingface.co/Comfy-Org/stable-audio-3/resolve/main
    fetch "$SA/checkpoints/stable_audio_3_small_music.safetensors" "$M/checkpoints/stable_audio_3_small_music.safetensors"
    fetch "$SA/text_encoders/t5gemma_b_b_ul2.safetensors"         "$M/text_encoders/t5gemma_b_b_ul2.safetensors" ;;
  video)
    # Wan 2.2 TI2V-5B, Apache-2.0 weights (see PLAN.md §5b). GGUF needs the ComfyUI-GGUF node (Apache-2.0).
    C="${VIDEO_APP_COMFYUI:-$ROOT/vendor/ComfyUI}"; N="$C/custom_nodes/ComfyUI-GGUF"; PIN=6ea2651e7df66d7585f6ffee804b20e92fb38b8a
    if [[ ! -d "$N" ]]; then git clone -q https://github.com/city96/ComfyUI-GGUF "$N"; git -C "$N" checkout -q "$PIN"; fi
    uv pip install -q --python "$C/.venv/bin/python" -r "$N/requirements.txt"
    fetch https://huggingface.co/QuantStack/Wan2.2-TI2V-5B-GGUF/resolve/main/Wan2.2-TI2V-5B-Q8_0.gguf \
          "$M/diffusion_models/Wan2.2-TI2V-5B-Q8_0.gguf"
    fetch https://huggingface.co/city96/umt5-xxl-encoder-gguf/resolve/main/umt5-xxl-encoder-Q5_K_M.gguf \
          "$M/text_encoders/umt5-xxl-encoder-Q5_K_M.gguf"
    fetch https://huggingface.co/Comfy-Org/Wan_2.2_ComfyUI_Repackaged/resolve/main/split_files/vae/wan2.2_vae.safetensors \
          "$M/vae/wan2.2_vae.safetensors" ;;
  voice)
    K=https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files-v1.0
    fetch "$K/kokoro-v1.0.onnx" "$M/kokoro/kokoro-v1.0.onnx"
    fetch "$K/voices-v1.0.bin"  "$M/kokoro/voices-v1.0.bin" ;;
  *)
    sed -n '2,7p' "$0"; exit 1 ;;
esac
